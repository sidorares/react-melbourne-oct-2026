{
  "name": "react-x11-stress-demo",
  "version": "0.0.0",
  "private": true,
  "description": "A scripted trailer for react-x11 and @react-x11/components: every component in one window, with the frames it drops printed to the terminal.",
  "type": "module",
  "scripts": {
    "start": "bun index.tsx",
    "start:node": "node --import tsx index.tsx",
    "prefetch": "bun index.tsx --prefetch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@react-x11/components": "^0.25.0",
    "@xterm/headless": "^6.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.3",
    "react": "^19.2.8",
    "react-x11": "^2.50.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
